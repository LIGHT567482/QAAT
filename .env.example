# ─── Database ───────────────────────────────────────────────────────────────
# DB_USER is the OWNER/superuser that runs migrations + serves auth-service,
# sync-receiver, and the gateway's privileged ADMIN handlers (ADMIN_DB_URL).
DB_HOST=postgres
DB_PORT=5432
DB_NAME=qaat
DB_USER=qaat
DB_PASSWORD=qaat

# APP role: the NON-superuser, NON-BYPASSRLS role the tenant data plane connects
# as (api-gateway data plane, qr-generator, session-manager) so PostgreSQL RLS is
# actually enforced (see db/migrations/009 / update.md C1). Created by migration
# 003/009 with the password below — in production set it via your secrets manager
# (ALTER ROLE qaat_app PASSWORD ...) and never use the default.
APP_DB_USER=qaat_app
APP_DB_PASSWORD=qaat

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=qaat

# ─── Auth Service ───────────────────────────────────────────────────────────
# Generate with: openssl genrsa -out auth_private.pem 2048
# Then: openssl rsa -in auth_private.pem -pubout -out auth_public.pem
AUTH_RSA_PRIVATE_KEY_PATH=/run/secrets/auth_private.pem
AUTH_RSA_PUBLIC_KEY_PATH=/run/secrets/auth_public.pem
AUTH_JWT_ISSUER=qaat-auth
AUTH_JWT_AUDIENCE=qaat-api
AUTH_JWT_TTL_SECONDS=86400

# ─── API Gateway ────────────────────────────────────────────────────────────
API_PORT=8443
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── QR Generator ───────────────────────────────────────────────────────────
QR_SERVICE_PORT=3002
# 32-byte hex key for AES-256 encryption of tenant RSA private keys at rest
# Generate: openssl rand -hex 32
KEY_ENCRYPTION_KEY=changeme_generate_with_openssl_rand_hex_32

# ─── Notification ───────────────────────────────────────────────────────────
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Every outgoing email is sent from this address when set — make it a domain your
# SMTP relay is authorised for (SPF/DKIM), e.g. noreply@kiu.ac.ug. Unset, the
# notification-service derives it from the tenant branding domain (a real one only)
# and otherwise falls back to qaat.local — which NO real relay will accept.
EMAIL_FROM=
SENDGRID_API_KEY=
PLATFORM_DOMAIN=qaat.platform
# Gate for POST /notify/test-send — the operator's "prove the channels deliver" check
# on the notification-service. Disabled (503) until a key is set here / in Render; calls
# must present it in the X-Notify-Test-Key header. Generate: openssl rand -hex 16
NOTIFY_TEST_KEY=
# Web Push VAPID keys — generate with `pnpm dlx web-push generate-vapid-keys`.
# Leave blank to disable push (notification-service degrades to SMTP-only).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ─── Sync receiver ──────────────────────────────────────────────────────────
# REQUIRED — the sync-receiver reads this with mustEnv and REFUSES TO START without
# it. Leave it out and the one service that ingests a coordinator's sealed
# attendance package dies on boot, so every phone's upload fails while everything
# else looks healthy.
#
# It is the HMAC key the receiver verifies each package with. Generate:
#   openssl rand -hex 32
SYNC_SIGN_KEY=changeme_generate_with_openssl_rand_hex_32

# ─── Internal service calls ─────────────────────────────────────────────────
# Shared secret on service-to-service calls that never pass through a user token.
# The compose default below is fine locally and is NOT fine anywhere else.
INTERNAL_SVC_KEY=changeme_internal_svc_key

# ─── U-Panel (Contabo) ──────────────────────────────────────────────────────
# Read-only token for GET /api/attendance/* on the live U-Panel API.
# Create with: python manage.py create_attendance_api_token --role admin --create-service-user
# Never commit the real token. The gateway proxies it; the browser never sees it.
# ── U-PANEL INTEGRATION: DEFERRED TO V2 ────────────────────────────────────────
# v1 runs self-contained and never calls U-Panel. Left here, commented, because it
# is the integration's configuration for v2.
# UPANEL_API_URL=https://kiu.orion13.us
# UPANEL_API_TOKEN=

# Production on the same Contabo VPS as U-Panel: see .env.production.example
# and docs/CONTABO.md (separate compose project, host port 9080).

# Guards the gateway's /internal/cron/* endpoints. The gateway runs its own
# in-process scheduler, so this only matters if you also drive the jobs from an
# external pinger — but unset, that endpoint 401s everything, which reads as broken.
CRON_SECRET=

# ─── Civil time ─────────────────────────────────────────────────────────────
# Every "what day is it" resolves through internal/clock, which reads
# INSTITUTION_TZ; TZ pins the container (and so the Postgres session) to match.
# Unset, the services run UTC and every date is three hours out — which silently
# files a 09:00 lecture under the previous day.
TZ=Africa/Kampala
INSTITUTION_TZ=Africa/Kampala

# ─── Passkeys / WebAuthn ────────────────────────────────────────────────────
# RP_ID is the bare host (no scheme, no port); ORIGINS is the full origin list.
# They must match the address the browser actually uses or registration fails
# with a name mismatch that reports as a generic failure.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=QAAT
WEBAUTHN_RP_ORIGINS=https://localhost:8443

# Where a student's check-in QR points, and where the gateway reaches itself for
# the warden checks. Blank STUDENT_CHECKIN_BASE_URL falls back to the request host.
STUDENT_CHECKIN_BASE_URL=
WARDEN_BASE_URL=https://localhost:8443

# Set false to require TOTP at sign-in. True locally so a fresh stack is usable
# without enrolling an authenticator first.
DISABLE_MFA=true

# ─── Manifest ───────────────────────────────────────────────────────────────
CDN_MANIFEST_BUCKET=qaat-manifests-dev
TENANT_DEFAULT_THRESHOLD=75

# ─── Platform ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=debug

# ─── WhatsApp (employee attendance alerts) ───────────────────────────────────
# Late/early check-in alerts and the check-out reminder go out by email AND
# WhatsApp, because employees are non-teaching staff with no dashboard account —
# there is no in-app inbox to deliver to.
#
# Leave WHATSAPP_PROVIDER blank and the sender logs each message instead of
# sending it ([whatsapp:stub] in the notification-service log). That is a
# deliberate no-op, not a failure: the whole flow works end to end without
# credentials, and lights up the moment they are set. Email is unaffected either
# way.
#
# Pick ONE provider:
#   twilio — needs TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN
#   meta   — needs META_PHONE_NUMBER_ID, META_ACCESS_TOKEN
WHATSAPP_PROVIDER=

# The sender number the alert appears to come from. Defaults to 0786713144 (QAAT's
# business number). Change it here / in Render the day the institution assigns a
# different number — it must be the number registered with the provider. Local-form
# ("0786…") and E.164 ("+256…") are both accepted.
WHATSAPP_FROM_NUMBER=0786713144

# Twilio creds (only when WHATSAPP_PROVIDER=twilio).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Meta WhatsApp Cloud API creds (only when WHATSAPP_PROVIDER=meta). META_PHONE_NUMBER_ID
# is the numeric id from the Meta app dashboard, not the phone number itself.
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=

# Where the gateway reaches the notification-service to send these. The default
# is the compose service name; on Render it is the notify service's URL.
NOTIFICATION_URL=http://notification-service:3004
