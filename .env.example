# QAAT — environment template. Copy to .env and adjust.
# Every value below has a dev-safe default in the backend (internal/config).

# --- backend ---
QAAT_ADDR=:8080
# dev: sqlite://<path>.db or sqlite://:memory:   prod: postgres://user:pass@host:5432/db?sslmode=disable
QAAT_DATABASE_URL=sqlite://qaat.db
QAAT_JWT_SECRET=dev-insecure-secret-change-me
QAAT_ACCESS_TTL_SECONDS=7200
QAAT_PUBLIC_API_URL=http://localhost:8080
QAAT_APP_RETURN_URL=qaat://open/email-verified
# dev | test | prod
QAAT_ENV=dev

# --- web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- postgres (docker-compose) ---
POSTGRES_USER=qaat
POSTGRES_PASSWORD=qaat
POSTGRES_DB=qaat
POSTGRES_PORT=5432

# --- compose host ports ---
BACKEND_PORT=8080
WEB_PORT=3000
