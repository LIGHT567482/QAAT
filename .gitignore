# Environment
.env
.env.local
.env.production
*.env

# Go
services/*/bin/
services/*/*.test
services/*/vendor/

# Node
node_modules/
apps/*/node_modules/
apps/*/dist/
apps/*/.svelte-kit/

# Build artifacts
dist/
build/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Keys (never commit)
*.pem
*.key
*.p12
*.pfx
keys/
# Timestamped rotation backups: `qaat.key.bak-1783103535` ends in the timestamp,
# not in `.key`, so the patterns above sail straight past it. One such key did get
# committed this way. Match the backups by their own shape instead.
*.key.bak-*
*.pem.bak-*
*.crt.bak-*

# Docker volumes
pgdata/
redisdata/

# Test coverage
coverage/
*.out
next.txt
coordinator'sapp.md
HowItWorks.md
infra/render/secrets.generated.env

# Gradle build cache (was wrongly tracked) + local Playwright artifacts
.gradle/
frontend/*/.gradle/
tests/e2e/test-results/
tests/e2e/playwright-report/

# Android release signing secrets — never commit
frontend/coordinator-android/keystore.properties
frontend/coordinator-android/qaat-release.keystore
*.keystore
*.jks

# Kotlin/Gradle build scratch
frontend/coordinator-android/.kotlin/

# Compiled Go service binaries. These were tracked by accident — ~58 MB of build
# output that changes on every build, conflicts on every merge, and is rebuilt by
# the Dockerfile anyway. The pattern is the binary sharing its directory's name.
backend/api-gateway/api-gateway
backend/auth-service/auth-service
backend/sync-receiver/sync-receiver
backend/session-manager/session-manager
backend/notification-service/notification-service

# Android build output
frontend/coordinator-android/**/build/
frontend/coordinator-android/.gradle/
frontend/coordinator-android/local.properties

# Python bytecode from scripts/
__pycache__/
*.pyc
