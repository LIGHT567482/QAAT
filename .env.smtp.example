# ── Real SMTP credentials for QR email testing ──────────────────────────────
# Copy this file to .env.smtp and fill in your credentials.
# Then run: source .env.smtp && ./scripts/start_qr_generator.sh
#
# ── Gmail (App Password) ──────────────────────────────────────────────────────
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Generate a new App Password (select "Mail" + "Other device")
# 3. Use the 16-character code as SMTP_PASS below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-16-char-app-password

# ── SendGrid ───────────────────────────────────────────────────────────────────
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=SG.your-sendgrid-api-key

# ── Mailhog (local dev, no real delivery) ─────────────────────────────────────
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
