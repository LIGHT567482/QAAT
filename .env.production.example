# Copy to .env.production on the Contabo host. Never commit the filled file.
# Generate missing secrets with: bash scripts/contabo/gen-env.sh

# ─── Public hostnames (Cloudflare A records → same VPS IP as U-Panel) ────────
QAAT_HOST=qaat.orion13.us
QAAT_PORTAL_HOST=students.orion13.us
# Host port for qaat-proxy. 80 and 443 are taken (U-Panel nginx / SSH).
QAAT_PUBLISH_PORT=9080

# Empty VITE_API_URL = browser calls /api on the same origin the dashboard is served from.
VITE_API_URL=

# ─── Database (QAAT's own Postgres — not U-Panel's) ───────────────────────────
DB_NAME=qaat
DB_USER=qaat
DB_PASSWORD=change-me
APP_DB_USER=qaat_app
APP_DB_PASSWORD=change-me
SEED_KIU=true

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me

# ─── Auth / crypto ────────────────────────────────────────────────────────────
AUTH_JWT_ISSUER=qaat-auth
AUTH_JWT_AUDIENCE=qaat-api
AUTH_JWT_TTL_SECONDS=86400
# openssl rand -hex 32
KEY_ENCRYPTION_KEY=
INTERNAL_SVC_KEY=
SYNC_SIGN_KEY=
CRON_SECRET=

# First login is password-only. Set false after TOTP is enrolled for VC/DQA.
DISABLE_MFA=true

# ─── Public URL / CORS / WebAuthn ─────────────────────────────────────────────
API_CORS_ORIGINS=https://qaat.orion13.us,https://students.orion13.us
STUDENT_CHECKIN_BASE_URL=https://students.orion13.us
WARDEN_BASE_URL=https://qaat.orion13.us
WEBAUTHN_RP_ID=qaat.orion13.us
WEBAUTHN_RP_NAME=KIU QAAT
WEBAUTHN_RP_ORIGINS=https://qaat.orion13.us
PLATFORM_DOMAIN=qaat.orion13.us

TZ=Africa/Kampala
INSTITUTION_TZ=Africa/Kampala
LOG_LEVEL=info

# ─── U-Panel on this same VPS (read-only attendance API) ──────────────────────
# ── U-PANEL INTEGRATION: DEFERRED TO V2 ────────────────────────────────────────
# v1 runs self-contained and never calls U-Panel. Left here, commented, because it
# is the integration's configuration for v2.
# UPANEL_API_URL=https://kiu.orion13.us
# UPANEL_API_TOKEN=
# Must be NAME=value with no space after =. Wrong: UPANEL_API_TOKEN= abc  (bash runs "abc")

# ─── SMTP (optional — reuse Mailjet from U-Panel if you want mail) ────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ─── Cloudflare cache purge after deploy (same zone as kiu.orion13.us) ────────
# deploy-web-on-server.sh calls purge-cloudflare-cache.sh when both are set.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
